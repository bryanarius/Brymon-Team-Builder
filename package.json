{
  "name": "brymon",
  "version": "1.0.0",
  "description": "A full-stack Pokémon team builder built from scratch using a custom **PHP MVC architecture**, **PostgreSQL**, **JavaScript**, and the **PokéAPI**.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:js": "node --test \"tests/JS/*.test.js\"",
    "test:ts": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryanarius/Brymon-Team-Builder.git"
  },
  "keywords": [],
  "author": "",
